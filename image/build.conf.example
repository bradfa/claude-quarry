# Settings for image/build.sh. Copy this file to image/build.conf and edit it.
# Use KEY=value lines. Do not use quotes or spaces around the equals sign.
# An environment variable with the same name overrides a value in this file.
# build.sh asks for ADMIN_USER and ADMIN_SSH_KEY_FILE if you leave them out.

# Required. Name of the first user. This user gets sudo. Root cannot log in.
ADMIN_USER=alice

# Required. Path to the public key of ADMIN_USER. The key is not secret.
# A password login does not exist, so this key is the only way in.
ADMIN_SSH_KEY_FILE=/home/alice/.ssh/id_ed25519.pub

# How ADMIN_USER gets root with sudo.
#   agent    sudo asks your forwarded SSH agent to sign a challenge. Connect
#            with "ssh -A". sudo fails at the console and without an agent.
#   nopasswd sudo does not ask for anything.
SUDO_MODE=agent

# Host name of the installed host.
HOST_NAME=quarry-host

# Size of the image file. It holds a 2 GB ESP and a fixed-size root, so the
# default 34GB gives a root of about 30 GB. On the first boot, systemd-repart adds the
# swap partition and the VM storage partition in the free space of the target
# disk.
IMAGE_SIZE=34GB

# Size of the USB installer image. It holds a small Debian system and the
# compressed host image, which is much smaller than IMAGE_SIZE. The USB stick
# must be at least this large. Raise the value if the installer build stops
# because the file system is full.
INSTALLER_SIZE=8GB

# Extra kernel command line options. The last console= option is the system
# console. Boot messages, the emergency prompt, and the login prompt appear on
# it. Choose the example that fits how you work with the host.
#
# Example 1: a desktop or a laptop with a monitor. Leave the value empty. The
# kernel then uses the monitor as the system console.
KERNEL_CMDLINE_EXTRA=
#
# Example 2: a test in a virtual machine (QEMU with -nographic), or a host that
# you operate over a serial cable. The serial port becomes the system console.
# The monitor still shows the kernel messages.
#KERNEL_CMDLINE_EXTRA=console=tty0 console=ttyS0,115200

# Debian mirror used for the build.
MIRROR=http://deb.debian.org/debian/
